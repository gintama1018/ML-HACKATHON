# XYZ AI — Environment Configuration
# Copy this file to .env and fill in your values

# --- REQUIRED FOR PRODUCTION ---
# JWT signing secret — must be set in any non-local environment
JWT_SECRET_KEY=

# --- LLM PROVIDER (only one needed) ---
# Set one of these to enable real NLU. Without any key, the system runs in
# degraded keyword-matching mode with significantly limited NLU.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- DATABASE (defaults to local SQLite for dev) ---
# Set to a Postgres URL for production deployment
DATABASE_URL=

# --- OPTIONAL ---
RATE_LIMIT_RPM=60
