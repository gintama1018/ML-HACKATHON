# XYZ AI — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.

# =============================================================================
# REQUIRED FOR PRODUCTION
# =============================================================================

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Must be set in any non-local environment. Leaving blank causes a loud warning and ephemeral key.
JWT_SECRET_KEY=

# =============================================================================
# DATABASE
# =============================================================================
# Production: Supabase Session Pooler (port 6543 — required for serverless/Vercel)
# Format: postgresql://postgres.XXXX:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Get it from: Supabase Dashboard → Project → Settings → Database → Connection string → Session mode
DATABASE_URL=

# Local development: leave DATABASE_URL blank (auto-uses SQLite at ./school_erp.db)
# To seed the database: cd backend && python seed/seed_data.py

# =============================================================================
# LLM PROVIDER — Set ONE to enable real NLU (keyword fallback if none set)
# =============================================================================
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# =============================================================================
# OPTIONAL
# =============================================================================
# CORS — comma-separated list of allowed origins (use * for open, or your Vercel URL)
# Example: ALLOWED_ORIGINS=https://your-project.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=*

# Rate limiting (requests per minute per user)
RATE_LIMIT_RPM=60

# Redis (optional — for distributed rate limiting; falls back to in-memory without it)
# REDIS_URL=redis://localhost:6379/0

# =============================================================================
# VERCEL DEPLOYMENT NOTES
# =============================================================================
# Set these in Vercel Dashboard → Project → Settings → Environment Variables:
#   DATABASE_URL → your Supabase Session Pooler URI (port 6543)
#   JWT_SECRET_KEY → a long random hex string
#   ALLOWED_ORIGINS → https://your-project.vercel.app
#   OPENAI_API_KEY or GEMINI_API_KEY (optional, enables real NLU)
